# Newsletter — Resend Audiences.
# Without both of these the signup endpoint returns 503 and the form says so.
# It never reports success for a subscription that was not stored.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Contact form — Resend Emails.
# CONTACT_FROM_EMAIL must be on a domain verified in Resend. The visitor's
# address goes in reply_to, never in from: spoofing it fails SPF and puts the
# whole domain in spam.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Canonical origin. Every canonical URL, sitemap entry, OG tag and JSON-LD
# `url` is built from this, so it must be a host that actually resolves — a
# canonical pointing at a dead domain gets the page dropped from the index
# rather than indexed under a different name. Unset, the app falls back to
# Vercel's stable production host (VERCEL_PROJECT_PRODUCTION_URL, injected
# automatically) and then to http://localhost:3000. Set it explicitly, with
# protocol and no trailing slash, as soon as a custom domain is live.
NEXT_PUBLIC_SITE_URL=

# Search engine ownership verification — production only.
# Google Search Console → Add property → HTML tag; paste only the content
# value, not the whole <meta> tag. Leave blank anywhere but production: a
# preview deployment carrying the production token claims a domain it does not
# own. If you have registrar access, verify by DNS TXT instead and leave this
# unset — DNS verification survives a redeploy that drops the variable.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# None of these are NEXT_PUBLIC_*, so none of them can reach the client bundle.

# ── Keystatic, GitHub storage ────────────────────────────────────────────────
# Only needed for the DEPLOYED admin. Local development uses file storage and
# needs none of these.
#
# Do not fill these in by hand. Deploy first, open /keystatic on the live site,
# and follow the setup screen — it creates the GitHub App and shows you the
# exact values to paste here.
#
# The first three are server-only secrets. The fourth is deliberately public:
# it is only the App's URL slug, used to build the authorise link.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
